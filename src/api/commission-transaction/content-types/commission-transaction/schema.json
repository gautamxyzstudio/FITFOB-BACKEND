{
  "kind": "collectionType",
  "collectionName": "commission_transactions",
  "info": {
    "singularName": "commission-transaction",
    "pluralName": "commission-transactions",
    "displayName": "commission-transactions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "gym_membership": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gym-membership.gym-membership",
      "inversedBy": "commission_transactions"
    },
    "gym_contract": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gym-contract.gym-contract",
      "inversedBy": "commission_transactions"
    },
    "gym_promotion": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gym-promotion.gym-promotion",
      "inversedBy": "commission_transactions"
    },
    "commissionMode": {
      "type": "enumeration",
      "enum": [
        "default",
        "custom",
        "promotion"
      ]
    },
    "customerPrice": {
      "type": "decimal"
    },
    "commissionAmount": {
      "type": "decimal"
    },
    "gymPayout": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "INR"
    },
    "promotionApplied": {
      "type": "boolean",
      "default": false
    },
    "transactionStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "failed"
      ]
    },
    "notes": {
      "type": "text"
    }
  }
}
