{
  "kind": "collectionType",
  "collectionName": "commission_transactions",
  "info": {
    "singularName": "commission-transaction",
    "pluralName": "commission-transactions",
    "displayName": "commission-transactions"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "transactionId": {
      "type": "uid"
    },
    "gym_membership": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gym-membership.gym-membership",
      "inversedBy": "commission_transactions"
    },
    "gym_contract": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gym-contract.gym-contract",
      "inversedBy": "commission_transactions"
    },
    "gym_promotion": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gym-promotion.gym-promotion",
      "inversedBy": "commission_transactions"
    },
    "transactionType": {
      "type": "enumeration",
      "enum": [
        "charge",
        "refund",
        "adjustment",
        "settlement"
      ]
    },
    "commissionMode": {
      "type": "enumeration",
      "enum": [
        "default",
        "custom",
        "promotion"
      ]
    },
    "customerPrice": {
      "type": "decimal"
    },
    "commissionAmount": {
      "type": "decimal"
    },
    "gatewayFee": {
      "type": "decimal"
    },
    "gymPayout": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "INR"
    },
    "promotionApplied": {
      "type": "boolean",
      "default": false
    },
    "promotionSequence": {
      "type": "integer"
    },
    "transactionStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ]
    },
    "providerPaymentId": {
      "type": "string"
    },
    "providerTransactionId": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string",
      "unique": true
    },
    "settledAt": {
      "type": "datetime"
    },
    "notes": {
      "type": "text"
    }
  }
}
