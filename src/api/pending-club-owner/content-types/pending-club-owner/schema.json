{
  "kind": "collectionType",
  "collectionName": "pending_club_owners",
  "info": {
    "singularName": "pending-club-owner",
    "pluralName": "pending-club-owners",
    "displayName": "Pending-Club-Owner"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "pending_club_owner"
    },
    "currentStep": {
      "type": "integer",
      "default": 1
    },
    "status": {
      "type": "enumeration",
      "default": "draft",
      "enum": [
        "draft",
        "completed"
      ]
    },
    "clubName": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "latitude": {
      "type": "string"
    },
    "longitude": {
      "type": "string"
    },
    "clubAddress": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "pincode": {
      "type": "string"
    },
    "ownerName": {
      "type": "string"
    },
    "phoneNumber": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "services": {
      "type": "json"
    },
    "facilities": {
      "type": "json"
    },
    "weekdayScheduling": {
      "type": "json"
    },
    "club_owner_documents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::club-owner-document.club-owner-document",
      "mappedBy": "pending_club_owner"
    },
    "clubCategory": {
      "type": "enumeration",
      "enum": [
        "Premium",
        "Luxury"
      ]
    },
    "club_services": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::club-service.club-service",
      "mappedBy": "pending_club_owners"
    },
    "club_facilities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::club-facility.club-facility",
      "inversedBy": "pending_club_owners"
    },
    "club_photos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::club-photo.club-photo",
      "mappedBy": "pending_club_owner"
    },
    "isPhoneVerified": {
      "type": "boolean",
      "default": false
    },
    "isEmailVerified": {
      "type": "boolean",
      "default": false
    }
  }
}
