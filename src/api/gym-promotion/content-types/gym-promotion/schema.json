{
  "kind": "collectionType",
  "collectionName": "gym_promotions",
  "info": {
    "singularName": "gym-promotion",
    "pluralName": "gym-promotions",
    "displayName": "gym-promotion"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "gym_contract": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::gym-contract.gym-contract",
      "inversedBy": "gym_promotions"
    },
    "promotionType": {
      "type": "enumeration",
      "default": "zero_commission",
      "enum": [
        "zero_commission"
      ]
    },
    "userLimit": {
      "type": "integer"
    },
    "usedUserCount": {
      "type": "integer"
    },
    "reservedUserCount": {
      "type": "integer"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "startDate": {
      "type": "date"
    },
    "endDate": {
      "type": "date"
    },
    "commission_transactions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::commission-transaction.commission-transaction",
      "mappedBy": "gym_promotion"
    }
  }
}
